<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#111827">
  <title>DocScan Mail</title>
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="icon" href="icons/icon-192.svg">
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
  <style>
    :root{--bg:#020617;--card:#111827;--text:#f9fafb;--muted:#9ca3af;--line:#374151;--accent:#22c55e;--danger:#ef4444}
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:linear-gradient(180deg,#020617,#111827);color:var(--text);min-height:100vh}
    main{max-width:920px;margin:0 auto;padding:14px}
    h1{margin:12px 0 4px;font-size:26px}
    h2{margin:4px 0 12px;font-size:20px}
    p,.hint{color:var(--muted);line-height:1.4}
    .card{background:rgba(17,24,39,.94);border:1px solid var(--line);border-radius:18px;padding:14px;margin:12px 0;box-shadow:0 10px 30px rgba(0,0,0,.25)}
    .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    button,label.filebtn,input,textarea,select{border-radius:12px;padding:12px 14px;font-size:16px}
    button,label.filebtn{background:#1f2937;color:var(--text);cursor:pointer;border:1px solid #4b5563}
    button.primary{background:var(--accent);color:#052e16;font-weight:800;border-color:transparent}
    button.danger{background:var(--danger);color:white;border-color:transparent}
    button:disabled{opacity:.45;cursor:not-allowed}
    input,textarea,select{width:100%;background:#020617;color:var(--text);border:1px solid var(--line);margin-top:8px}
    textarea{min-height:86px;resize:vertical}
    canvas{width:100%;border-radius:14px;background:#000;border:1px solid var(--line)}
    #workCanvas{touch-action:none;max-height:72vh;object-fit:contain}
    #pages{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:10px}
    .thumb{position:relative;background:#020617;border:1px solid var(--line);border-radius:12px;padding:8px}
    .thumb img{width:100%;border-radius:8px;display:block}
    .thumb small{color:var(--muted);display:block;margin-top:6px}
    .thumb .x{position:absolute;top:6px;right:6px;padding:5px 9px;font-size:13px}
    .status{padding:10px 12px;border-radius:12px;background:#020617;border:1px solid var(--line);color:var(--muted);margin-top:10px}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    @media(max-width:720px){.grid2{grid-template-columns:1fr}}
    .pill{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:6px 10px;color:var(--muted);font-size:13px}

    dialog.cameraDialog{
      width:100vw;
      height:100dvh;
      max-width:none;
      max-height:none;
      margin:0;
      padding:0;
      border:0;
      background:#000;
      color:white;
    }
    dialog::backdrop{background:#000}
    .cameraShell{
      position:fixed;
      inset:0;
      display:grid;
      grid-template-rows:1fr auto;
      background:#000;
    }
    #cameraVideo{
      width:100%;
      height:100%;
      object-fit:contain;
      background:#000;
    }
    .cameraBar{
      display:flex;
      justify-content:center;
      align-items:center;
      gap:12px;
      padding:14px;
      padding-bottom:calc(14px + env(safe-area-inset-bottom));
      background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.88));
    }
    .cameraBar button{min-width:110px}
    .shotButton{
      width:72px;
      height:72px;
      border-radius:999px;
      border:5px solid white;
      background:var(--accent);
      color:#052e16;
      font-weight:900;
    }
    .cornerHint{font-size:14px;color:#9ca3af}
  </style>
</head>
<body>
<main>
  <h1>📄 DocScan Mail</h1>
  <p>Dokument fotografieren, vier Ecken setzen, Scan verbessern, als PDF bündeln und per Mail-App teilen.</p>

  <section class="card">
    <h2>1. Dokument erfassen</h2>
    <div class="row">
      <button id="openCamera" class="primary">Kamera öffnen</button>
      <label class="filebtn">Bild wählen<input id="fileInput" type="file" accept="image/*" multiple hidden></label>
      <span class="pill">Kamera öffnet im Vollbild-Popup</span>
    </div>
    <p class="hint">Nach der Aufnahme kannst du die vier grünen Ecken an die Dokumentkanten ziehen.</p>
  </section>

  <section class="card">
    <h2>2. Scan bearbeiten</h2>
    <div class="grid2">
      <div>
        <canvas id="workCanvas"></canvas>
        <canvas id="hiddenCanvas" hidden></canvas>
        <p class="cornerHint">Ziehe die vier grünen Punkte auf die Dokumentecken.</p>
      </div>
      <div>
        <label>Scan-Modus</label>
        <select id="filterMode">
          <option value="document">Dokument: Graustufen + hoher Kontrast</option>
          <option value="bw">Schwarzweiß stark</option>
          <option value="color">Farbe optimiert</option>
          <option value="original">Original</option>
        </select>
        <label>Helligkeit</label>
        <input id="brightness" type="range" min="-80" max="80" value="10">
        <label>Kontrast</label>
        <input id="contrast" type="range" min="-80" max="120" value="45">
        <div class="row" style="margin-top:12px">
          <button id="rotateLeft" disabled>↶ Drehen</button>
          <button id="rotateRight" disabled>↷ Drehen</button>
          <button id="resetCorners" disabled>Ecken zurücksetzen</button>
          <button id="autoEnhance" disabled>Auto verbessern</button>
          <button id="addPage" class="primary" disabled>Seite übernehmen</button>
        </div>
        <p class="hint">Die Ecken werden beim Übernehmen ausgeschnitten. Für perfekte Entzerrung wäre später OpenCV.js der nächste saubere Ausbau.</p>
      </div>
    </div>
  </section>

  <section class="card">
    <h2>3. Mail vorbereiten</h2>
    <input id="mailTo" type="email" placeholder="Empfänger, z. B. name@firma.de">
    <input id="subject" type="text" value="Dokumente als PDF" placeholder="Betreff">
    <textarea id="body">Hallo,

anbei die eingescannten Dokumente.

Viele Grüße</textarea>
    <div class="row" style="margin-top:10px">
      <button id="sharePdf" class="primary" disabled>PDF teilen</button>
      <button id="downloadPdf" disabled>PDF herunterladen</button>
      <button id="clear" class="danger" disabled>Alles löschen</button>
    </div>
    <div id="status" class="status">Noch keine Seite übernommen.</div>
  </section>

  <section class="card">
    <h2>Seiten im PDF</h2>
    <div id="pages"></div>
  </section>
</main>

<dialog id="cameraDialog" class="cameraDialog">
  <div class="cameraShell">
    <video id="cameraVideo" playsinline autoplay muted></video>
    <div class="cameraBar">
      <button id="closeCamera">Schließen</button>
      <button id="takePhoto" class="shotButton">Scan</button>
    </div>
  </div>
</dialog>

<script>
const workCanvas = document.getElementById("workCanvas");
const hiddenCanvas = document.getElementById("hiddenCanvas");
const wctx = workCanvas.getContext("2d");
const hctx = hiddenCanvas.getContext("2d");

const cameraDialog = document.getElementById("cameraDialog");
const cameraVideo = document.getElementById("cameraVideo");

let stream = null;
let sourceImage = null;
let rotation = 0;
let scans = [];
let corners = null;
let activeCorner = null;

const els = {
  openCamera: document.getElementById("openCamera"),
  closeCamera: document.getElementById("closeCamera"),
  takePhoto: document.getElementById("takePhoto"),
  fileInput: document.getElementById("fileInput"),
  filterMode: document.getElementById("filterMode"),
  brightness: document.getElementById("brightness"),
  contrast: document.getElementById("contrast"),
  rotateLeft: document.getElementById("rotateLeft"),
  rotateRight: document.getElementById("rotateRight"),
  resetCorners: document.getElementById("resetCorners"),
  autoEnhance: document.getElementById("autoEnhance"),
  addPage: document.getElementById("addPage"),
  sharePdf: document.getElementById("sharePdf"),
  downloadPdf: document.getElementById("downloadPdf"),
  clear: document.getElementById("clear"),
  pages: document.getElementById("pages"),
  status: document.getElementById("status")
};

function status(text){ els.status.textContent = text; }

function updateButtons(){
  const hasSource = !!sourceImage;
  const hasPages = scans.length > 0;
  els.rotateLeft.disabled = !hasSource;
  els.rotateRight.disabled = !hasSource;
  els.resetCorners.disabled = !hasSource;
  els.autoEnhance.disabled = !hasSource;
  els.addPage.disabled = !hasSource;
  els.sharePdf.disabled = !hasPages;
  els.downloadPdf.disabled = !hasPages;
  els.clear.disabled = !hasPages && !hasSource;
}

async function openCamera(){
  try{
    cameraDialog.showModal();
    stream = await navigator.mediaDevices.getUserMedia({
      video:{facingMode:{ideal:"environment"},width:{ideal:1920},height:{ideal:1080}},
      audio:false
    });
    cameraVideo.srcObject = stream;
  }catch(e){
    console.error(e);
    status("Kamera konnte nicht gestartet werden. HTTPS und Kamera-Berechtigung prüfen.");
    closeCamera();
  }
}

function closeCamera(){
  if(stream){
    stream.getTracks().forEach(track=>track.stop());
    stream = null;
  }
  cameraVideo.srcObject = null;
  if(cameraDialog.open) cameraDialog.close();
}

function loadImageFromDataUrl(dataUrl){
  return new Promise(resolve=>{
    const img = new Image();
    img.onload = () => resolve(img);
    img.src = dataUrl;
  });
}

async function takePhoto(){
  const c = hiddenCanvas;
  c.width = cameraVideo.videoWidth || 1280;
  c.height = cameraVideo.videoHeight || 720;
  hctx.drawImage(cameraVideo,0,0,c.width,c.height);
  sourceImage = await loadImageFromDataUrl(c.toDataURL("image/jpeg",0.95));
  rotation = 0;
  closeCamera();
  resetCorners();
  renderWork();
  status("Foto übernommen. Ziehe die vier Ecken auf das Dokument.");
  updateButtons();
}

async function loadFiles(files){
  const file = [...files].find(f => f.type.startsWith("image/"));
  if(!file) return;
  const reader = new FileReader();
  reader.onload = async () => {
    sourceImage = await loadImageFromDataUrl(reader.result);
    rotation = 0;
    resetCorners();
    renderWork();
    status("Bild geladen. Ziehe die vier Ecken auf das Dokument.");
    updateButtons();
  };
  reader.readAsDataURL(file);
}

function rotatedSize(img){
  const r = ((rotation % 360) + 360) % 360;
  return (r === 90 || r === 270) ? {w:img.height,h:img.width} : {w:img.width,h:img.height};
}

function drawRotatedToCanvas(canvas, ctx, img){
  const size = rotatedSize(img);
  canvas.width = size.w;
  canvas.height = size.h;
  ctx.save();
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const r = ((rotation % 360) + 360) % 360;
  if(r === 90){ ctx.translate(canvas.width,0); ctx.rotate(Math.PI/2); }
  else if(r === 180){ ctx.translate(canvas.width,canvas.height); ctx.rotate(Math.PI); }
  else if(r === 270){ ctx.translate(0,canvas.height); ctx.rotate(-Math.PI/2); }
  ctx.drawImage(img,0,0);
  ctx.restore();
}

function resetCorners(){
  if(!sourceImage) return;
  const size = rotatedSize(sourceImage);
  const mx = size.w * 0.08;
  const my = size.h * 0.08;
  corners = [
    {x:mx,y:my},
    {x:size.w-mx,y:my},
    {x:size.w-mx,y:size.h-my},
    {x:mx,y:size.h-my}
  ];
}

function enhanceImageData(imageData){
  const data = imageData.data;
  const mode = els.filterMode.value;
  const brightness = Number(els.brightness.value);
  const contrast = Number(els.contrast.value);
  const factor = (259 * (contrast + 255)) / (255 * (259 - contrast));

  for(let i=0;i<data.length;i+=4){
    let r=data[i], g=data[i+1], b=data[i+2];

    if(mode === "document" || mode === "bw"){
      const gray = 0.299*r + 0.587*g + 0.114*b;
      r=g=b=gray;
    }

    r = factor * (r - 128) + 128 + brightness;
    g = factor * (g - 128) + 128 + brightness;
    b = factor * (b - 128) + 128 + brightness;

    if(mode === "bw"){
      const t = (r+g+b)/3 > 165 ? 255 : 0;
      r=g=b=t;
    }

    if(mode === "color"){
      r = r * 1.04;
      g = g * 1.04;
      b = b * 1.04;
    }

    data[i]=Math.max(0,Math.min(255,r));
    data[i+1]=Math.max(0,Math.min(255,g));
    data[i+2]=Math.max(0,Math.min(255,b));
  }
  return imageData;
}

function renderWork(){
  if(!sourceImage) return;
  drawRotatedToCanvas(workCanvas, wctx, sourceImage);
  const imageData = wctx.getImageData(0,0,workCanvas.width,workCanvas.height);
  wctx.putImageData(enhanceImageData(imageData),0,0);

  if(corners){
    wctx.save();
    wctx.strokeStyle = "#22c55e";
    wctx.lineWidth = Math.max(5, workCanvas.width/220);
    wctx.beginPath();
    wctx.moveTo(corners[0].x,corners[0].y);
    wctx.lineTo(corners[1].x,corners[1].y);
    wctx.lineTo(corners[2].x,corners[2].y);
    wctx.lineTo(corners[3].x,corners[3].y);
    wctx.closePath();
    wctx.stroke();
    wctx.fillStyle = "rgba(34,197,94,.12)";
    wctx.fill();

    corners.forEach((p,i)=>{
      wctx.beginPath();
      wctx.arc(p.x,p.y,Math.max(18,workCanvas.width/70),0,Math.PI*2);
      wctx.fillStyle = "#22c55e";
      wctx.fill();
      wctx.lineWidth = Math.max(4, workCanvas.width/260);
      wctx.strokeStyle = "#052e16";
      wctx.stroke();
      wctx.fillStyle = "#052e16";
      wctx.font = `${Math.max(18,workCanvas.width/55)}px system-ui`;
      wctx.textAlign = "center";
      wctx.textBaseline = "middle";
      wctx.fillText(String(i+1),p.x,p.y);
    });
    wctx.restore();
  }
}

function canvasPoint(evt){
  const rect = workCanvas.getBoundingClientRect();
  const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
  const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
  return {
    x: (clientX - rect.left) * (workCanvas.width / rect.width),
    y: (clientY - rect.top) * (workCanvas.height / rect.height)
  };
}

function nearestCorner(point){
  if(!corners) return null;
  let best = null;
  let bestDist = Infinity;
  corners.forEach((p,i)=>{
    const d = Math.hypot(p.x-point.x,p.y-point.y);
    if(d < bestDist){ bestDist = d; best = i; }
  });
  const threshold = Math.max(70, workCanvas.width/12);
  return bestDist <= threshold ? best : null;
}

function startCornerDrag(evt){
  if(!sourceImage || !corners) return;
  evt.preventDefault();
  const p = canvasPoint(evt);
  activeCorner = nearestCorner(p);
}

function moveCornerDrag(evt){
  if(activeCorner === null) return;
  evt.preventDefault();
  const p = canvasPoint(evt);
  corners[activeCorner] = {
    x: Math.max(0,Math.min(workCanvas.width,p.x)),
    y: Math.max(0,Math.min(workCanvas.height,p.y))
  };
  renderWork();
}

function endCornerDrag(){
  activeCorner = null;
}

function distance(a,b){ return Math.hypot(a.x-b.x,a.y-b.y); }

function createFinalPageDataUrl(){
  if(!sourceImage || !corners) return null;

  drawRotatedToCanvas(hiddenCanvas,hctx,sourceImage);
  let imageData = hctx.getImageData(0,0,hiddenCanvas.width,hiddenCanvas.height);
  hctx.putImageData(enhanceImageData(imageData),0,0);

  const [tl,tr,br,bl] = corners;
  const outW = Math.round(Math.max(distance(tl,tr), distance(bl,br)));
  const outH = Math.round(Math.max(distance(tl,bl), distance(tr,br)));

  const tmp = document.createElement("canvas");
  tmp.width = Math.max(200,outW);
  tmp.height = Math.max(200,outH);
  const tctx = tmp.getContext("2d");

  // Näherungsweise perspektivischer Zuschnitt:
  // Das Dokument wird zeilenweise zwischen linker und rechter Kante interpoliert.
  // Für echte Homographie wäre OpenCV.js der nächste Schritt.
  const steps = tmp.height;
  for(let y=0; y<steps; y++){
    const v = y / Math.max(1,steps-1);
    const leftX = tl.x + (bl.x - tl.x) * v;
    const leftY = tl.y + (bl.y - tl.y) * v;
    const rightX = tr.x + (br.x - tr.x) * v;
    const rightY = tr.y + (br.y - tr.y) * v;

    tctx.drawImage(
      hiddenCanvas,
      leftX, leftY, Math.max(1,rightX-leftX), Math.max(1,(rightY-leftY)/steps),
      0, y, tmp.width, 1
    );
  }

  return tmp.toDataURL("image/jpeg",0.95);
}

function addPage(){
  const dataUrl = createFinalPageDataUrl();
  if(!dataUrl) return;
  scans.push({dataUrl,createdAt:new Date().toISOString()});
  sourceImage = null;
  corners = null;
  wctx.clearRect(0,0,workCanvas.width,workCanvas.height);
  renderPages();
  status(`${scans.length} Seite(n) im PDF.`);
  updateButtons();
}

function renderPages(){
  els.pages.innerHTML = "";
  scans.forEach((scan,index)=>{
    const div = document.createElement("div");
    div.className = "thumb";
    div.innerHTML = `<button class="x">×</button><img src="${scan.dataUrl}"><small>Seite ${index+1}</small>
      <div class="row" style="margin-top:6px"><button data-up>↑</button><button data-down>↓</button></div>`;
    div.querySelector(".x").onclick = () => { scans.splice(index,1); renderPages(); updateButtons(); };
    div.querySelector("[data-up]").onclick = () => { if(index>0){ [scans[index-1],scans[index]]=[scans[index],scans[index-1]]; renderPages(); }};
    div.querySelector("[data-down]").onclick = () => { if(index<scans.length-1){ [scans[index+1],scans[index]]=[scans[index],scans[index+1]]; renderPages(); }};
    els.pages.appendChild(div);
  });
}

function imageSize(dataUrl){
  return new Promise(resolve=>{
    const img = new Image();
    img.onload = () => resolve({img,width:img.width,height:img.height});
    img.src = dataUrl;
  });
}

async function createPdfBlob(){
  const { jsPDF } = window.jspdf;
  const pdf = new jsPDF({orientation:"p",unit:"mm",format:"a4"});
  const pageW=210,pageH=297,margin=8;
  for(let i=0;i<scans.length;i++){
    if(i>0) pdf.addPage();
    const {width,height} = await imageSize(scans[i].dataUrl);
    const maxW = pageW - margin*2, maxH = pageH - margin*2;
    const ratio = Math.min(maxW/width,maxH/height);
    const imgW = width*ratio, imgH = height*ratio;
    pdf.addImage(scans[i].dataUrl,"JPEG",(pageW-imgW)/2,(pageH-imgH)/2,imgW,imgH);
  }
  return pdf.output("blob");
}

function pdfName(){
  return `Scan_${new Date().toISOString().slice(0,10)}.pdf`;
}

function downloadBlob(blob){
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = pdfName(); document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

async function sharePdf(){
  const blob = await createPdfBlob();
  const file = new File([blob], pdfName(), {type:"application/pdf"});
  const subject = document.getElementById("subject").value || "Dokumente";
  const body = document.getElementById("body").value || "";
  const to = document.getElementById("mailTo").value || "";

  if(navigator.canShare && navigator.canShare({files:[file]}) && navigator.share){
    await navigator.share({title:subject,text:body + (to ? "\nEmpfänger: " + to : ""),files:[file]});
    status("PDF wurde an die Teilen-Auswahl übergeben.");
  }else{
    downloadBlob(blob);
    window.location.href = `mailto:${encodeURIComponent(to)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body + "\n\nPDF wurde heruntergeladen und muss manuell angehängt werden.")}`;
    status("Browser unterstützt Datei-Teilen nicht. PDF wurde heruntergeladen.");
  }
}

async function downloadPdf(){
  const blob = await createPdfBlob();
  downloadBlob(blob);
  status("PDF heruntergeladen.");
}

function autoEnhance(){
  els.filterMode.value = "document";
  els.brightness.value = 15;
  els.contrast.value = 70;
  renderWork();
}

function clearAll(){
  scans = [];
  sourceImage = null;
  corners = null;
  els.pages.innerHTML = "";
  wctx.clearRect(0,0,workCanvas.width,workCanvas.height);
  status("Alles gelöscht.");
  updateButtons();
}

els.openCamera.onclick = openCamera;
els.closeCamera.onclick = closeCamera;
els.takePhoto.onclick = takePhoto;
els.fileInput.onchange = e => loadFiles(e.target.files);
els.rotateLeft.onclick = () => { rotation -= 90; resetCorners(); renderWork(); };
els.rotateRight.onclick = () => { rotation += 90; resetCorners(); renderWork(); };
els.resetCorners.onclick = () => { resetCorners(); renderWork(); };
els.autoEnhance.onclick = autoEnhance;
els.addPage.onclick = addPage;
els.sharePdf.onclick = sharePdf;
els.downloadPdf.onclick = downloadPdf;
els.clear.onclick = clearAll;
els.filterMode.onchange = renderWork;
els.brightness.oninput = renderWork;
els.contrast.oninput = renderWork;

workCanvas.addEventListener("mousedown",startCornerDrag);
workCanvas.addEventListener("mousemove",moveCornerDrag);
window.addEventListener("mouseup",endCornerDrag);
workCanvas.addEventListener("touchstart",startCornerDrag,{passive:false});
workCanvas.addEventListener("touchmove",moveCornerDrag,{passive:false});
window.addEventListener("touchend",endCornerDrag);

if("serviceWorker" in navigator){
  window.addEventListener("load",()=>navigator.serviceWorker.register("service-worker.js"));
}
updateButtons();
</script>
</body>
</html>
